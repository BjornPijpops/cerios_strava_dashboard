{
  "name": "strava_dashboard",
  "version": "1.0.0",
  "description": "Dashboard for a company Strava challenge, built from the Strava activity API.",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test \"dist/**/*.test.js\"",
    "sync": "tsc && node dist/cli.js sync",
    "auth": "tsc && node dist/cli.js auth",
    "report": "tsc && node dist/cli.js report",
    "add-member": "tsc && node dist/cli.js add-member",
    "members": "tsc && node dist/cli.js members",
    "state-key": "tsc && node dist/cli.js state-key",
    "start": "tsc && node dist/server/main.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^25.0.0",
    "typescript": "^6.0.3"
  },
  "private": true
}
