# LOCAL USE ONLY. Copy to .env (git-ignored) and fill in. Never commit real values.
# In GitHub Actions these are not used: credentials and tokens come from the encrypted `state` branch (docs/deployment.md).
# Password that encrypts/decrypts the shared state. Generate with `npm run state-key`. Also add it as the
# Actions secret STATE_KEY. Needed for `npm run add-member` and `npm run members`.
STATE_KEY=
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Used once to seed data/tokens.json; afterwards rotated refresh tokens are read from there.
STRAVA_REFRESH_TOKEN=
# Athlete the seed refresh token belongs to (must be listed in config/challenge.json)
STRAVA_ATHLETE_ID=

# Optional
PORT=3000
# Minimum minutes between Strava syncs triggered by the dashboard
SYNC_TTL_MINUTES=30
